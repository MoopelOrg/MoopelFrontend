@attribute [Route(PageRoutes.Account)]
@attribute [Authorize]

@inject IAuthService AuthService

<PageTitle>Account - Moopel</PageTitle>

<section class="page page-narrow">
    <h1>Account</h1>

    @if (AuthService.CurrentUser is { } user)
    {
        <dl class="detail-list">
            <dt>Username</dt>
            <dd>@user.Username</dd>

            <dt>Email</dt>
            <dd>@(string.IsNullOrWhiteSpace(user.Email) ? "—" : user.Email)</dd>

            <dt>Role</dt>
            <dd>@user.Role</dd>

            <dt>Member since</dt>
            <dd>@user.CreatedAtUtc.ToString("yyyy-MM-dd")</dd>
        </dl>
    }
</section>
