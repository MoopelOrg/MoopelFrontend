@attribute [Route(PageRoutes.Home)]
@attribute [AllowAnonymous]

<PageTitle>Home - Moopel</PageTitle>

<section class="page">
    <h1>Moopel</h1>

    <AuthorizeView>
        <Authorized>
            <p>Welcome back, @context.User.Identity?.Name.</p>
            <p><a class="btn btn-primary" href="@PageRoutes.Notes">Go to your notes</a></p>
        </Authorized>
        <NotAuthorized>
            <p>Log in to get started.</p>
            <p><a class="btn btn-primary" href="@PageRoutes.Login">Log in</a></p>
        </NotAuthorized>
    </AuthorizeView>
</section>
