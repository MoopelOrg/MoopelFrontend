<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["css/base.css"]" />
    <link rel="stylesheet" href="@Assets["css/layout.css"]" />
    <link rel="stylesheet" href="@Assets["css/forms.css"]" />
    <link rel="stylesheet" href="@Assets["css/buttons.css"]" />
    <link rel="stylesheet" href="@Assets["css/cards.css"]" />
    <link rel="stylesheet" href="@Assets["css/utilities.css"]" />
    <link rel="stylesheet" href="@Assets["css/framework.css"]" />
    <link rel="stylesheet" href="@Assets["css/keyframes.css"]" />
    <link rel="stylesheet" href="@Assets["css/modules.css"]" />
    <link rel="stylesheet" href="@Assets["MoopelFrontend.styles.css"]" />
    <script>
        (() => {
            try {
                const raw = localStorage.getItem('moopel-theme');
                if (!raw) {
                    return;
                }

                const theme = JSON.parse(raw);
                if (!theme || typeof theme !== 'object') {
                    return;
                }

                const entries = Object.entries(theme).filter(([key, value]) => typeof key === 'string' && typeof value === 'string' && key.startsWith('--'));
                if (entries.length === 0) {
                    return;
                }

                let style = document.getElementById('moopel-theme-overrides');
                if (!style) {
                    style = document.createElement('style');
                    style.id = 'moopel-theme-overrides';
                    document.head.appendChild(style);
                }

                style.textContent = `:root { ${entries.map(([key, value]) => `${key}: ${value};`).join(' ')} }`;
            } catch {
            }
        })();
    </script>
    <ImportMap />
    <HeadOutlet @rendermode="RenderModes.AutoNoPrerender" />
</head>

<body>
    <Routes @rendermode="RenderModes.ServerNoPrerender" />
    <ReconnectModal />
    <script src="@Assets["js/authCookies.js"]"></script>
    <script src="@Assets["js/theme.js"]"></script>
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>
