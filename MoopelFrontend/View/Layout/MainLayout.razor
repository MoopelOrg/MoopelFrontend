@inherits LayoutComponentBase
@inject IAuthService AuthService
@inject ILogger<MainLayout> Logger
@inject NavigationManager NavigationManager
@inject MoopelAppSettings AppSettings

@if (!AuthService.IsInitialized)
{
    <div class="app-shell">
        <header class="app-header">
            <NavDrawer />
            <a class="app-brand" href="@PageRoutes.Home">Moopel</a>
            <nav class="app-nav"></nav>
            <div class="user-menu">
                <span class="state-message" role="status">Loading&hellip;</span>
            </div>
        </header>
    </div>
}
else
{
    <div class="app-shell">
        <header class="app-header">
            <NavDrawer />

            <a class="app-brand" href="@PageRoutes.Home">Moopel</a>

            <nav class="app-nav">
                @foreach (NavItem item in AppNav.Items)
                {
                    if (item.Href.Equals(RouteHelper.GetBaseUri(NavigationManager)))
                    {
                        <NavLink class="app-nav-link" href="@item.Href">@item.Label</NavLink>
                    }
                }
            </nav>

            <UserMenu />
        </header>

        <main class="app-main">
            <AppErrorBoundary @ref="_errorBoundary">
                <ChildContent>
                    @Body
                </ChildContent>
                <ErrorContent>
                    <div class="error-boundary" role="alert">
                        <p>Something went wrong. Please try again.</p>
                        <button type="button" class="btn btn-secondary" @onclick="RecoverFromError">Try again</button>
                    </div>
                </ErrorContent>
            </AppErrorBoundary>
        </main>
    </div>
}

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private AppErrorBoundary? _errorBoundary;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await AuthService.InitializeAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Main Layout: OnInitializedAsync");
        }
    }

    private void RecoverFromError() => _errorBoundary?.Recover();
}
