@inherits LayoutComponentBase
@inject IAuthService AuthService
@inject ILogger<MainLayout> Logger
@inject NavigationManager NavigationManager
@inject MoopelAppSettings AppSettings

@if (!AuthService.IsInitialized)
{
    <div class="@ShellClass">
        <header class="app-header">
            <NavDrawer />
            <a class="app-brand" href="@PageRoutes.Home">Moopel</a>
            <nav class="app-nav"></nav>
            <div class="user-menu">
                <span class="state-message" role="status">Loading&hellip;</span>
            </div>
        </header>
    </div>
}
else
{
    <div class="@ShellClass">
        <header class="app-header">
            <NavDrawer />

            <a class="app-brand" href="@PageRoutes.Home">Moopel</a>

            <nav class="app-nav">
                @foreach (NavItem item in AppNav.Items)
                {
                    if (item.Href.Equals(CurrentRoute, StringComparison.Ordinal))
                    {
                        <NavLink class="app-nav-link" href="@item.Href">@item.Label</NavLink>
                    }
                }
            </nav>

            <UserMenu />
        </header>

        <main class="@MainClass">
            <AppErrorBoundary @ref="_errorBoundary">
                <ChildContent>
                    @Body
                </ChildContent>
                <ErrorContent>
                    <div class="error-boundary" role="alert">
                        <p>Something went wrong. Please try again.</p>
                        <button type="button" class="btn btn-secondary" @onclick="RecoverFromError">Try again</button>
                    </div>
                </ErrorContent>
            </AppErrorBoundary>
        </main>
    </div>
}

@if (AppSettings.Environment == MoopelEnvironment.Test)
{
    <div id="blazor-error-ui" data-nosnippet>
        An unhandled error has occurred.
        <a href="." class="reload">Reload</a>
        <span class="dismiss">🗙</span>
    </div>
}

@code {
    private AppErrorBoundary? _errorBoundary;
    private string CurrentRoute => RouteHelper.GetBaseUri(NavigationManager);
    private bool IsDashboardRoute => CurrentRoute.Equals(PageRoutes.Dashboard, StringComparison.Ordinal);
    private string ShellClass => IsDashboardRoute ? "app-shell dashboard-shell" : "app-shell";
    private string MainClass => IsDashboardRoute ? "app-main dashboard-main" : "app-main";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await AuthService.InitializeAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Main Layout: OnInitializedAsync");
        }
    }

    private void RecoverFromError() => _errorBoundary?.Recover();
}
