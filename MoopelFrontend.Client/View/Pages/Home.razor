@attribute [Route(PageRoutes.Home)]
@attribute [AllowAnonymous]
@rendermode RenderModes.AutoNoPrerender
@inherits AuthInitializingComponentBase

@inject NavigationManager NavigationManager

<PageTitle>Home - Moopel</PageTitle>

@if (!IsAuthReady)
{
    <p class="state-message" role="status">Loading&hellip;</p>
}
else if (AuthService.CurrentUser is not null)
{
    <section class="page">
        <h1>Moopel</h1>
        <p>Welcome back, @AuthService.CurrentUser.Username.</p>
    </section>
}