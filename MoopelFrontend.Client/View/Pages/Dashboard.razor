@attribute [Route(PageRoutes.Dashboard)]
@attribute [AllowAnonymous]
@rendermode RenderModes.AutoNoPrerender
@inherits AuthInitializingComponentBase
@using MoopelFrontend.Client.View.Components.Dashboard

@inject NavigationManager NavigationManager

<PageTitle>Dashboard - Moopel</PageTitle>

@if (!IsAuthReady)
{
    <p class="state-message" role="status">Loading&hellip;</p>
}
else if (AuthService.CurrentUser is not null)
{
    <section class="page launcher">
        <header class="launcher-copy">
            <h1>Welcome</h1>
            <p class="muted">Organization and productivity starts here</p>
        </header>

        <ul class="app-grid">
            @foreach (AppTile tile in AppTiles)
            {
                <AppLauncherCard Tile="tile" />
            }
        </ul>

        <p class="launcher-actions">
            <a class="launcher-settings" href="@PageRoutes.Settings">
                <span aria-hidden="true">@UiGlyphs.Settings</span>
                <span>Settings</span>
            </a>
        </p>
    </section>
}

@code {
    private List<AppTile> AppTiles { get; set; } = [];

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        if (AuthService.CurrentUser is null)
        {
            NavigationManager.NavigateTo($"{PageRoutes.Login}?{PageRoutes.ReturnUrlParameter}={PageRoutes.Dashboard}");
            return;
        }

        // TODO: Populate this off of user settings
        AppTiles = AppLauncher.Tiles.ToList();
    }
}
