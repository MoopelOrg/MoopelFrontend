@attribute [Route(PageRoutes.NewTransaction)]
@attribute [AllowAnonymous]
@rendermode RenderModes.AutoNoPrerender
@inherits AuthInitializingComponentBase

@inject NavigationManager NavigationManager

<PageTitle>New Transaction - Moopel</PageTitle>

@if (!IsAuthReady)
{
    <p class="state-message" role="status">Loading&hellip;</p>
}
else if (AuthService.CurrentUser is not null)
{
    <div class="module-form-page">
        <header class="new-note-header">
            <div class="new-note-header-left">
                <a class="module-icon-btn" href="@PageRoutes.Transactions" aria-label="Back to transactions">&#8592;</a>
                <div class="new-note-kicker">
                    <span class="module-kicker-icon">💳</span>
                    <span>New Transaction</span>
                </div>
            </div>
            <div class="module-header-actions">
                <a class="btn btn-secondary" href="@PageRoutes.Transactions">Discard</a>
                <button type="button" class="btn btn-primary" @onclick="Save">Save Transaction</button>
            </div>
        </header>

        <div class="module-form-section">
            <div class="module-field">
                <label for="tx-name">Merchant / Description</label>
                <input id="tx-name" type="text" class="large" placeholder="e.g. Walmart, Salary Deposit..." @bind="_name" />
            </div>

            <div class="module-field-row">
                <div class="module-field">
                    <label for="tx-amount">Amount</label>
                    <input id="tx-amount" type="number" step="0.01" min="0" placeholder="0.00" @bind="_amount" />
                </div>
                <div class="module-field">
                    <label for="tx-type">Type</label>
                    <select id="tx-type" @bind="_txType">
                        <option value="debit">Debit (expense)</option>
                        <option value="credit">Credit (income)</option>
                    </select>
                </div>
            </div>

            <div class="module-field-row">
                <div class="module-field">
                    <label for="tx-account">Account</label>
                    <select id="tx-account" @bind="_account">
                        <option value="">Select account...</option>
                        <option>Primary Savings</option>
                        <option>Daily Expenses</option>
                        <option>Emergency Fund</option>
                    </select>
                </div>
                <div class="module-field">
                    <label for="tx-category">Category</label>
                    <select id="tx-category" @bind="_category">
                        <option value="">Select category...</option>
                        <option>Groceries</option>
                        <option>Bills</option>
                        <option>Income</option>
                        <option>Transport</option>
                        <option>Dining</option>
                        <option>Utilities</option>
                    </select>
                </div>
            </div>

            <div class="module-field">
                <label for="tx-date">Date</label>
                <input id="tx-date" type="datetime-local" @bind="_date" />
            </div>

            <div class="module-field">
                <label for="tx-description">Notes (optional)</label>
                <textarea id="tx-description" rows="3" placeholder="Any additional notes..." @bind="_description"></textarea>
            </div>
        </div>

        <div class="module-form-section">
            <span class="module-form-section-label">Transaction Items</span>
            <p class="module-muted new-transaction-items-help">Break this transaction into line items for detailed tracking.</p>
            <button type="button" class="module-form-dashed-add">+ Add Item</button>
        </div>
    </div>
}

@code {
    private string _name = string.Empty;
    private decimal _amount;
    private string _txType = "debit";
    private string _account = string.Empty;
    private string _category = string.Empty;
    private DateTime _date = DateTime.Now;
    private string _description = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        if (AuthService.CurrentUser is null)
        {
            NavigationManager.NavigateTo($"{PageRoutes.Login}?{PageRoutes.ReturnUrlParameter}={Uri.EscapeDataString(PageRoutes.NewTransaction)}");
        }
    }

    private void Save()
    {
        // TODO: Persist via API when Banking service is available.
        NavigationManager.NavigateTo(PageRoutes.Transactions);
    }
}
