@using NoteType = MoopelObjects.Enums.NoteType

@attribute [Route(PageRoutes.Notes)]
@attribute [AllowAnonymous]
@rendermode RenderModes.AutoNoPrerender
@inherits AuthInitializingComponentBase

@inject INotesService NotesApi
@inject NavigationManager NavigationManager

<PageTitle>Notes - Moopel</PageTitle>

@if (!IsAuthReady)
{
    <p class="state-message" role="status">Loading&hellip;</p>
}
else if (AuthService.CurrentUser is not null)
{
    <div class="notes-layout">
        <aside class="notes-sidebar" aria-label="Notes library">
            <header class="notes-sidebar-header">
                <h1 class="notes-sidebar-title">Library</h1>
                <a class="notes-sidebar-new-btn" href="@PageRoutes.NewNote" aria-label="Create new note">+</a>
            </header>

            <div class="notes-type-filters" role="group" aria-label="Filter by type">
                <button type="button"
                        class="notes-type-filter @(_activeFilter == null ? "active" : string.Empty)"
                        @onclick="() => SetFilter(null)">All</button>
                @foreach (NoteType type in Enum.GetValues<NoteType>())
                {
                    <button type="button"
                            class="notes-type-filter @(_activeFilter == type ? "active" : string.Empty)"
                            @onclick="() => SetFilter(type)">@type</button>
                }
            </div>

            @if (_isLoading)
            {
                <div class="module-state"><p role="status">Loading notes&hellip;</p></div>
            }
            else if (_notes is null)
            {
                <div class="module-state"><p>Could not load notes.</p></div>
            }
            else if (FilteredNotes.Count == 0)
            {
                <div class="module-state">
                    <p>No notes yet.</p>
                    <a class="btn btn-primary" href="@PageRoutes.NewNote">Create your first note</a>
                </div>
            }
            else
            {
                <ul class="notes-list" role="list">
                    @foreach (Note listNote in FilteredNotes)
                    {
                        <li>
                            <button type="button"
                                    class="notes-list-item @(_selectedNote?.NoteId == listNote.NoteId ? "active" : string.Empty)"
                                    @onclick="() => SelectNote(listNote)">
                                <div class="notes-list-item-header">
                                    <span class="notes-list-item-type">@listNote.Type</span>
                                    <span class="notes-list-item-date">@listNote.CreatedAtUtc.ToString("MMM d")</span>
                                </div>
                                <p class="notes-list-item-title">@listNote.Title</p>
                                <p class="notes-list-item-preview">@listNote.Content</p>
                            </button>
                        </li>
                    }
                </ul>
            }
        </aside>

        <section class="notes-detail" aria-label="Note detail">
            @if (_selectedNote is { } note)
            {
                <header class="notes-detail-header">
                    <div class="notes-detail-meta">
                        <span class="notes-detail-type-badge">@note.Type</span>
                        <span class="notes-detail-edited module-muted">Last edited @note.CreatedAtUtc.ToString("MMM d, yyyy")</span>
                    </div>
                    <div class="notes-detail-actions">
                        @if (_pendingDeleteId == note.NoteId)
                        {
                            <span class="notes-delete-confirm">
                                Delete?
                                <button type="button" class="btn btn-danger" @onclick="() => DeleteNoteAsync(note.NoteId)">Yes, delete</button>
                                <button type="button" class="btn btn-secondary" @onclick="() => _pendingDeleteId = null">Cancel</button>
                            </span>
                        }
                        else
                        {
                            <button type="button" class="module-icon-btn module-icon-btn--danger" aria-label="Delete note" @onclick="() => _pendingDeleteId = note.NoteId">🗑</button>
                        }
                        <a class="btn btn-primary notes-edit-btn" href="@PageRoutes.Notes">✏ Edit Note</a>
                    </div>
                </header>

                @if (!string.IsNullOrWhiteSpace(_errorMessage))
                {
                    <p class="form-error" role="alert">@_errorMessage</p>
                }

                <article class="notes-detail-body">
                    <h2 class="notes-detail-title">@note.Title</h2>
                    <p class="notes-detail-content">@note.Content</p>
                </article>
            }
            else if (!_isLoading)
            {
                <div class="notes-detail-empty module-state">
                    <p>Select a note from the library, or create a new one.</p>
                    <a class="btn btn-primary" href="@PageRoutes.NewNote">New note</a>
                </div>
            }
        </section>
    </div>
}

@code {
    private List<Note>? _notes;
    private Note? _selectedNote;
    private NoteType? _activeFilter;
    private bool _isLoading = true;
    private string? _errorMessage;
    private int? _pendingDeleteId;

    private List<Note> FilteredNotes =>
        _notes is null ? [] :
        _activeFilter is null ? _notes :
        _notes.Where(n => n.Type == _activeFilter).ToList();

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        if (AuthService.CurrentUser is null)
        {
            NavigationManager.NavigateTo(PageRoutes.Login);
            return;
        }

        await LoadNotesAsync();
    }

    private async Task LoadNotesAsync()
    {
        _isLoading = true;
        _errorMessage = null;

        ApiResult<List<Note>> result = await NotesApi.GetMyNotesAsync();
        _notes = result.Success ? result.Value : null;
        if (!result.Success)
            _errorMessage = result.Message;

        if (_selectedNote is not null && _notes is not null)
            _selectedNote = _notes.FirstOrDefault(n => n.NoteId == _selectedNote.NoteId);

        _isLoading = false;
    }

    private void SelectNote(Note note) => _selectedNote = note;

    private void SetFilter(NoteType? type)
    {
        _activeFilter = type;
        _selectedNote = null;
    }

    private async Task DeleteNoteAsync(int noteId)
    {
        _pendingDeleteId = null;
        _errorMessage = null;

        ApiResult<bool> result = await NotesApi.DeleteNoteAsync(noteId);
        if (result.Success)
        {
            _selectedNote = null;
            await LoadNotesAsync();
        }
        else
        {
            _errorMessage = result.Message;
        }
    }
}

