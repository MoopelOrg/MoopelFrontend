<li class="app-tile @Tile.GroupClass">
    @if (Tile.IsAvailable)
    {
        <a class="app-tile-link" href="@Tile.Href">
            <span class="app-tile-icon" aria-hidden="true">
                @if (!string.IsNullOrWhiteSpace(Tile.Badge))
                {
                    <small class="app-tile-badge">@Tile.Badge</small>
                }

                <img class="app-tile-image" src="@Tile.ImageUrl" alt="" loading="lazy" />
            </span>
            <span class="app-tile-label">@Tile.Label</span>
        </a>
    }
    else
    {
        <span class="app-tile-link app-tile-disabled" aria-disabled="true">
            <span class="app-tile-icon" aria-hidden="true">
                @if (!string.IsNullOrWhiteSpace(Tile.Badge))
                {
                    <small class="app-tile-badge">@Tile.Badge</small>
                }

                <img class="app-tile-image" src="@Tile.ImageUrl" alt="" loading="lazy" />
            </span>
            <span class="app-tile-label">@Tile.Label</span>
        </span>
    }
</li>

@code {
    [Parameter, EditorRequired]
    public AppTile Tile { get; set; } = default!;
}
